FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    torch==2.6.0 torchvision==0.21.0

COPY requirements-bacteria.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY api_common.py api_bacteria.py bacteria_main.py ./
COPY model/bacteria_efficientnet_b0_best.pt ./model/bacteria_efficientnet_b0_best.pt
COPY config/classes.json config/model_config.json ./model/config/

EXPOSE 8000
CMD ["uvicorn", "bacteria_main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]