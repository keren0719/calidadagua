FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/agua \
    MODEL_C_DIR=/models

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-water.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY agua/ ./agua/
COPY water_main.py ./

EXPOSE 8000
CMD ["uvicorn", "water_main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]